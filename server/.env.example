NODE_ENV=development
PORT=4000

# Railway PostgreSQL sets this automatically when the database service is linked.
DATABASE_URL=

# Local PostgreSQL fallback when DATABASE_URL is empty.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=monitoring_supplier

# SSL options:
# - production/Railway uses SSL by default.
# - set PGSSLMODE=disable only for local databases that do not support SSL.
# - set PGSSLMODE=no-verify only when the provider requires SSL without a verifiable CA.
PGSSLMODE=
PGSSL_REJECT_UNAUTHORIZED=

FRONTEND_URL=http://localhost:3000
JWT_SECRET=change_this_to_a_long_random_secret
SESSION_INACTIVITY_TIMEOUT_MINUTES=15
DEFAULT_RESET_PASSWORD=123456

# Optional first admin seed. Leave empty if the admin already exists.
ADMIN_USER=
ADMIN_PASSWORD=

# Optional email integration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=

# Optional persistent upload root. Use Railway Volume mount path in production.
UPLOAD_DIR=
SERVE_FRONTEND=true
SLOW_REQUEST_MS=500
SLOW_SQL_MS=500
PRL_FORECAST_BOM_CONCURRENCY=4
